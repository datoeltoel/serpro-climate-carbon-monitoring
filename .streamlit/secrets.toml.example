# COPY this structure into Streamlit Cloud > App settings > Secrets.
# IMPORTANT: do NOT commit real passwords or cookie keys.
# Password values must be bcrypt hashes because utils/auth.py uses auto_hash=False.

[auth.cookie]
name = "serpro_mrv_auth"
key = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
expiry_days = 30

[auth.credentials.usernames.guest]
email = "guest@example.com"
name = "Guest User"
password = "REPLACE_WITH_BCRYPT_HASH"
roles = ["guest"]

[auth.credentials.usernames.management]
email = "management@example.com"
name = "Management User"
password = "REPLACE_WITH_BCRYPT_HASH"
roles = ["management"]

[auth.credentials.usernames.gis]
email = "gis@example.com"
name = "GIS Specialist"
password = "REPLACE_WITH_BCRYPT_HASH"
roles = ["gis_specialist"]

[auth.credentials.usernames.forestry]
email = "forestry@example.com"
name = "Forestry Planner"
password = "REPLACE_WITH_BCRYPT_HASH"
roles = ["forestry_planner"]

[auth.credentials.usernames.mrv]
email = "mrv@example.com"
name = "MRV Specialist"
password = "REPLACE_WITH_BCRYPT_HASH"
roles = ["mrv_specialist"]
